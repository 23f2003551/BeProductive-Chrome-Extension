{
  "manifest_version": 3,
  "name": "BeProductive",
  "version": "1.0",
  "permissions": ["tabs", "activeTab", "storage", "windows"],
  "host_permissions": ["http://127.0.0.1:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open BeProductive",
    "default_popup": "index.html"
  }
}